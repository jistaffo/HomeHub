# Copy this file to .env and fill in your keys. Never commit .env.

# Free key from https://www.themoviedb.org/settings/api
# (either the "API Key" or the longer "API Read Access Token" works).
# Search, posters, top-4 cast, director/writer credits.
TMDB_API_KEY=

# Free key from https://www.omdbapi.com/apikey.aspx (activate it from the email).
# IMDb, Rotten Tomatoes and Metacritic scores, plus IMDb plot summaries.
OMDB_API_KEY=

# Optional: spoiler-free descriptions written by Claude. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional settings
# PORT=4100
# DATA_FILE=./data/top10.json
# INVITE_CODE=pick-your-own
# MAX_USERS=10
